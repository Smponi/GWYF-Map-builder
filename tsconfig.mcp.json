{
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "Node16",
        "target": "ES2022",
        "outDir": "./dist",
        "rootDir": ".",
        "removeComments": true,
        "preserveConstEnums": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": false,
        "declaration": false,
        "forceConsistentCasingInFileNames": false
    },
    "include": [
        "mcp/**/*.ts",
        "domain/**/*.ts",
        "config/**/*.ts",
        "generator/**/*.ts",
        "customTerrain/**/*.ts"
    ]
}
